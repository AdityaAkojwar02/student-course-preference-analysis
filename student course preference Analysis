)
add_button.grid(row=2, column=1, pady=15)

clear_button = tk.Button(
    input_frame,
    text="CLEAR",
    command=clear_fields,
    bg="#757575",
    fg="white",
    font=("Arial", 11, "bold"),
    width=18
)
clear_button.grid(row=2, column=2, pady=15)

# Search Frame
search_frame = tk.Frame(root, bg="#f2f2f2")
search_frame.pack(fill=tk.X, padx=20)

tk.Label(
    search_frame,
    text="Search Student:",
    font=("Arial", 11, "bold"),
    bg="#f2f2f2"
).pack(side=tk.LEFT, padx=5)

search_entry = tk.Entry(search_frame, width=25)
search_entry.pack(side=tk.LEFT, padx=5)

tk.Button(
    search_frame,
    text="SEARCH",
    command=search_student,
    bg="#2196F3",
    fg="white",
    font=("Arial", 10, "bold")
).pack(side=tk.LEFT, padx=5)

tk.Button(
    search_frame,
    text="SHOW ALL",
    command=display_students,
    bg="#607D8B",
    fg="white",
    font=("Arial", 10, "bold")
).pack(side=tk.LEFT, padx=5)

# Table
table_frame = tk.Frame(root)
table_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=15)

columns = ("Name", "Roll No", "Year", "Course Preference")

table = ttk.Treeview(
    table_frame,
    columns=columns,
    show="headings"
)

for col in columns:
    table.heading(col, text=col)
    table.column(col, width=200)

table.pack(fill=tk.BOTH, expand=True)

# Buttons
button_frame = tk.Frame(root, bg="#f2f2f2")
button_frame.pack(pady=15)

tk.Button(
    button_frame,
    text="COURSE ANALYSIS",
    command=show_analysis,
    bg="#FF9800",
    fg="white",
    font=("Arial", 11, "bold"),
    width=18
).grid(row=0, column=0, padx=8)

tk.Button(
    button_frame,
    text="SHOW CHART",
    command=show_chart,
    bg="#9C27B0",
    fg="white",
    font=("Arial", 11, "bold"),
    width=18
).grid(row=0, column=1, padx=8)

tk.Button(
    button_frame,
    text="STATISTICS",
    command=show_statistics,
    bg="#009688",
    fg="white",
    font=("Arial", 11, "bold"),
    width=18
).grid(row=0, column=2, padx=8)

# Load existing data
display_students()

root.mainloop()