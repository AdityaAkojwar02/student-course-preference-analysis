root = tk.Tk()
root.title("Students Course Preference Analysis")
root.geometry("1000x700")
root.configure(bg="#f2f2f2")

title = tk.Label(
    root,
    text="STUDENTS COURSE PREFERENCE ANALYSIS",
    font=("Arial", 22, "bold"),
    bg="#263238",
    fg="white",
    pady=15
)
title.pack(fill=tk.X)

# Input Frame
input_frame = tk.LabelFrame(
    root,
    text="Student Details",
    font=("Arial", 13, "bold"),
