import tkinter as tk
from tkinter import ttk, messagebox
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os

FILE = "student_course_preferences.csv"

# -------------------- DATA --------------------

courses = [
    "Computer Science",
    "Artificial Intelligence",
    "Data Science",
    "Cyber Security",
    "IoT",
    "Cloud Computing"
]

if os.path.exists(FILE):
    df = pd.read_csv(FILE)
else:
    df = pd.DataFrame(columns=["Name", "Roll No", "Year", "Course Preference"])


# -------------------- FUNCTIONS --------------------

def add_student():
    global df

    name = name_entry.get().strip()
    roll = roll_entry.get().strip()
    year = year_combo.get()
    course = course_combo.get()

    if name == "" or roll == "" or year == "" or course == "":
        messagebox.showwarning("Warning", "Please fill all fields.")
        return

    if roll in df["Roll No"].astype(str).values:
        messagebox.showerror("Error", "Roll number already exists.")
        return

    new_student = pd.DataFrame([{
        "Name": name,
        "Roll No": roll,
        "Year": year,
        "Course Preference": course
    }])

    df = pd.concat([df, new_student], ignore_index=True)
    df.to_csv(FILE, index=False)

    clear_fields()
    display_students()

    messagebox.showinfo("Success", "Student added successfully!")


def clear_fields():
    name_entry.delete(0, tk.END)
    roll_entry.delete(0, tk.END)
    year_combo.set("")
    course_combo.set("")


def display_students():
    for item in table.get_children():
        table.delete(item)

    for _, row in df.iterrows():
        table.insert("", tk.END, values=(
            row["Name"],
            row["Roll No"],
            row["Year"],
            row["Course Preference"]
        ))


def show_analysis():
    if df.empty:
        messagebox.showinfo("Analysis", "No student data available.")
        return

    counts = df["Course Preference"].value_counts()

    total = len(df)
    most_preferred = counts.idxmax()
    highest = counts.max()

    result = f"""
STUDENT COURSE PREFERENCE ANALYSIS

Total Students: {total}

Most Preferred Course:
{most_preferred}

Number of Students:
{highest}

Course Preference:

"""

    for course, count in counts.items():
        percentage = (count / total) * 100
        result += f"{course}: {count} students ({percentage:.2f}%)\n"

    messagebox.showinfo("Analysis Result", result)


def show_chart():
    if df.empty:
        messagebox.showwarning("Warning", "No data available.")
        return

    counts = df["Course Preference"].value_counts()

    plt.figure(figsize=(10, 6))
    counts.plot(kind="bar")

    plt.title("Students Course Preference Analysis")
    plt.xlabel("Courses")
    plt.ylabel("Number of Students")
    plt.xticks(rotation=30, ha="right")
    plt.tight_layout()
    plt.show()


def search_student():
    name = search_entry.get().strip().lower()

    if name == "":
        messagebox.showwarning("Warning", "Enter a student name.")
        return

    result = df[df["Name"].astype(str).str.lower().str.contains(name)]

    for item in table.get_children():
        table.delete(item)

    for _, row in result.iterrows():
        table.insert("", tk.END, values=(
            row["Name"],
            row["Roll No"],
            row["Year"],
            row["Course Preference"]
        ))

    if result.empty:
        messagebox.showinfo("Search", "Student not found.")


def show_statistics():
    if df.empty:
        messagebox.showinfo("Statistics", "No data available.")
        return

    total_students = len(df)
    unique_courses = df["Course Preference"].nunique()

    result = f"""
STATISTICS

Total Students: {total_students}
Courses Available: {unique_courses}

Average Preference Value:
{np.mean(df["Course Preference"].value_counts()):.2f}

Most Popular:
{df["Course Preference"].value_counts().idxmax()}
"""

    messagebox.showinfo("Statistics", result)


