    padx=15,
    pady=15
)
input_frame.pack(fill=tk.X, padx=20, pady=15)

tk.Label(input_frame, text="Student Name:",
         bg="#f2f2f2").grid(row=0, column=0, padx=10, pady=8)

name_entry = tk.Entry(input_frame, width=25)
